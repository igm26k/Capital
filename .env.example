# Local only. Copy to .env and replace the password with a URL-safe random value.
POSTGRES_USER=accounting
POSTGRES_DB=accounting
POSTGRES_PASSWORD=replace_with_random_url_safe_password
WEB_PORT=8443
PUBLIC_ORIGIN=https://localhost:8443
REGISTRATION_ENABLED=false

AUTH_HASH_CONCURRENCY=2
AUTH_IP_ATTEMPTS_PER_MINUTE=100
AUTH_EMAIL_ATTEMPTS_PER_MINUTE=20

# Dev/test Docker networks; override if these overlap LAN/VPN routes.
ACCOUNTING_DEV_SUBNET=192.168.240.0/24
ACCOUNTING_TEST_SUBNET=192.168.241.0/24

# Optional workaround when VPN prevents Docker build access to npm registry.
# DOCKER_BUILD_NETWORK=host

# Optional until bootstrap is used. Keep keys stable across API restarts.
# JSON map of key IDs to base64-encoded random keys (at least 32 bytes each).
# Set both variables; preserve prior keys for at least 90 days during rotation.
SYNC_CURSOR_ACTIVE_KEY=
SYNC_CURSOR_KEYS=
